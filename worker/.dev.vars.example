# Lokale Entwicklungs-/Test-Secrets für den BLUnion-Worker (siehe worker/.gitignore -
# ".dev.vars" selbst wird NIE committed). Diese Datei hier IST committed - kopiere sie einmalig zu
# ".dev.vars" im selben Ordner und trag dort deine eigenen Werte ein:
#
#   cp .dev.vars.example .dev.vars
#
# Wird sowohl von "wrangler dev" als auch von "npm test" (siehe vitest.config.mts/
# @cloudflare/vitest-plugin, das dieselbe wrangler.toml + .dev.vars lädt) automatisch gelesen.

# Ed25519-Public-Key deiner Discord-Application (Hex, siehe Discord Developer Portal -> deine
# App -> "General Information" -> "Public Key") - siehe DISCORD_INTEGRATION.md. In Produktion
# NIEMALS hier, sondern per "wrangler secret put DISCORD_PUBLIC_KEY" gesetzt (siehe wrangler.toml).
DISCORD_PUBLIC_KEY=

# Vier region-spezifische Discord-Webhook-URLs (Phase 1.5 "persistente Gruppen-Karten", siehe
# DISCORD_INTEGRATION.md und DATA_CENTER_TO_REGION in src/index.ts) - je EINE pro FFXIV-Region
# (NICHT pro Data Center), Format ".../api/webhooks/<id>/<token>" (siehe Discord Developer Portal
# bzw. Kanal-Einstellungen -> Integrationen -> Webhooks -> "Neuer Webhook" -> "Webhook-URL
# kopieren"). Optional - fehlt eine Region hier, legt/aktualisiert der Worker für Gruppen auf
# dieser Region einfach keine Karte an, ohne den zugrunde liegenden Gruppen-PUT/DELETE zu
# beeinträchtigen (siehe Env.DISCORD_WEBHOOK_NA-Doc in src/index.ts). In Produktion NIEMALS hier,
# sondern per "wrangler secret put DISCORD_WEBHOOK_NA" (analog für _EU/_JP/_OC) gesetzt.
DISCORD_WEBHOOK_NA=
DISCORD_WEBHOOK_EU=
DISCORD_WEBHOOK_JP=
DISCORD_WEBHOOK_OC=

# Klickbarer Discord-Link im Plugin (siehe buildDiscordChannelLink/Env.DISCORD_GUILD_ID-Doc in
# src/index.ts) - anders als die Webhook-URLs oben KEIN Secret, in Produktion normale [vars] in
# wrangler.toml statt "wrangler secret put". IDs per Rechtsklick auf Server/Kanal in Discord mit
# aktiviertem Entwicklermodus ("ID kopieren") ermitteln. Fehlt DISCORD_GUILD_ID oder die Channel-ID
# einer Region, zeigt das Plugin stattdessen die allgemeine Server-Einladung.
DISCORD_GUILD_ID=
DISCORD_CHANNEL_NA=
DISCORD_CHANNEL_EU=
DISCORD_CHANNEL_JP=
DISCORD_CHANNEL_OC=
# Nur für die Anzeige ("Discord: #<name>") - rein kosmetisch, siehe Env.DISCORD_CHANNEL_NAME_NA-Doc.
DISCORD_CHANNEL_NAME_NA=
DISCORD_CHANNEL_NAME_EU=
DISCORD_CHANNEL_NAME_JP=
DISCORD_CHANNEL_NAME_OC=
